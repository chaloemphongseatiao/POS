generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  displayName  String
  role         String   @default("CASHIER")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders         Order[]
  stockMovements StockMovement[]
  shiftsOpened   Shift[]         @relation("ShiftOpenedBy")
  shiftsClosed   Shift[]         @relation("ShiftClosedBy")
  refunds        Refund[]
  ledgerEntries  LedgerEntry[]
}

// ─── Categories ───────────────────────────────────────────────────────────────

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  products Product[]
}

// ─── Products ─────────────────────────────────────────────────────────────────

model Product {
  id           Int       @id @default(autoincrement())
  barcode      String?   @unique
  name         String
  description  String?
  costPrice    Decimal
  sellPrice    Decimal
  unit         String    @default("ชิ้น")
  imageUrl     String?
  isActive     Boolean   @default(true)
  lowStockAt   Int       @default(5)
  reorderPoint Int       @default(5)
  reorderQty   Int       @default(10)
  expiryDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  stock          Stock?
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  refundItems    RefundItem[]
  promotions     ProductPromotion[]
}

// ─── Stock ────────────────────────────────────────────────────────────────────

model Stock {
  id        Int      @id @default(autoincrement())
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  productId Int     @unique
  product   Product @relation(fields: [productId], references: [id])
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  type      String
  quantity  Int
  note      String?
  createdAt DateTime @default(now())

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id])
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id            Int      @id @default(autoincrement())
  orderNumber   String   @unique
  subtotal      Decimal
  discountAmt   Decimal  @default(0)
  totalAmt      Decimal
  paymentMethod String
  amountPaid    Decimal
  changeAmt     Decimal
  status        String   @default("COMPLETED")
  note          String?
  createdAt     DateTime @default(now())

  cashierId Int
  cashier   User @relation(fields: [cashierId], references: [id])

  shiftId Int?
  shift   Shift? @relation(fields: [shiftId], references: [id])

  items          OrderItem[]
  stockMovements StockMovement[]
  refunds        Refund[]

  @@index([shiftId])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  quantity    Int
  unitPrice   Decimal
  costPrice   Decimal
  subtotal    Decimal
  /// How many of `quantity` have been given back to the customer.
  refundedQty Int     @default(0)

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  refundItems RefundItem[]
}

// ─── Refunds ──────────────────────────────────────────────────────────────────

model Refund {
  id           Int      @id @default(autoincrement())
  refundNumber String   @unique
  totalAmt     Decimal
  /// Cost of the returned goods, snapshotted so reports can undo the profit.
  totalCost    Decimal  @default(0)
  reason       String?
  /// Returned goods put back on the shelf; false when they are damaged.
  restock      Boolean  @default(true)
  createdAt    DateTime @default(now())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  shiftId Int?
  shift   Shift? @relation(fields: [shiftId], references: [id])

  items RefundItem[]

  @@index([orderId])
  @@index([createdAt])
}

model RefundItem {
  id        Int     @id @default(autoincrement())
  quantity  Int
  unitPrice Decimal
  costPrice Decimal
  subtotal  Decimal

  refundId Int
  refund   Refund @relation(fields: [refundId], references: [id])

  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id])
}

// ─── Shifts ───────────────────────────────────────────────────────────────────

model Shift {
  id           Int       @id @default(autoincrement())
  /// Cash in the drawer when the shift was opened.
  openingCash  Decimal
  /// Cash counted at close; null while the shift is still open.
  closingCash  Decimal?
  /// Opening cash + cash sales - cash refunds, frozen at close.
  expectedCash Decimal?
  /// closingCash - expectedCash: negative means the drawer is short.
  diffCash     Decimal?
  note         String?
  openedAt     DateTime  @default(now())
  closedAt     DateTime?

  openedById Int
  openedBy   User @relation("ShiftOpenedBy", fields: [openedById], references: [id])

  closedById Int?
  closedBy   User? @relation("ShiftClosedBy", fields: [closedById], references: [id])

  orders  Order[]
  refunds Refund[]

  @@index([openedAt])
}

// ─── Promotions ───────────────────────────────────────────────────────────────

model Promotion {
  id        Int       @id @default(autoincrement())
  name      String
  type      String
  value     Decimal
  minQty    Int       @default(1)
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products ProductPromotion[]
}

model ProductPromotion {
  id          Int       @id @default(autoincrement())
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  promotionId Int
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([productId, promotionId])
}

// ─── Ledger (income / expense) ─────────────────────────────────────────────────

model LedgerCategory {
  id        Int      @id @default(autoincrement())
  name      String
  /// "INCOME" | "EXPENSE"
  type      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  entries   LedgerEntry[]
  recurring RecurringEntry[]

  @@unique([name, type])
}

model LedgerEntry {
  id        Int      @id @default(autoincrement())
  /// Snapshotted from the category at creation, so re-typing a category later can't reclassify old entries.
  type      String
  /// VAT-inclusive, like every other price in the system.
  amount    Decimal
  /// True when this amount carries claimable/payable VAT (a tax invoice exists).
  hasVat    Boolean  @default(false)
  /// Rate snapshotted at entry time, so changing the shop's rate can't rewrite old tax.
  vatRate   Decimal  @default(0)
  note      String?
  /// The Bangkok calendar day this entry books to (not necessarily when it was entered).
  entryDate DateTime
  createdAt DateTime @default(now())

  categoryId Int
  category   LedgerCategory @relation(fields: [categoryId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  /// Set when the entry was posted from a recurring template rather than typed by hand.
  recurringId Int?
  recurring   RecurringEntry? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  /// One posting per template per day, so re-running the poster can't double-charge.
  /// Hand-typed entries have a null recurringId, which Postgres treats as distinct,
  /// so they are not constrained by this.
  @@unique([recurringId, entryDate])
  @@index([entryDate])
}

/// A fixed cost that repeats on a schedule (rent, salary, internet). Nothing is
/// booked until the poster runs, so the ledger only ever holds real postings.
model RecurringEntry {
  id        Int       @id @default(autoincrement())
  name      String
  /// Snapshotted from the category, same reason as LedgerEntry.type.
  type      String
  amount    Decimal
  hasVat    Boolean   @default(false)
  note      String?
  /// "MONTHLY" | "WEEKLY"
  frequency String
  /// Day of the month (1-31) when MONTHLY, day of the week (0 = Sunday) when WEEKLY.
  /// A monthly day past the end of a short month books on that month's last day.
  dayOf     Int       @default(1)
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  categoryId Int
  category   LedgerCategory @relation(fields: [categoryId], references: [id])

  entries LedgerEntry[]
}

// ─── Settings ─────────────────────────────────────────────────────────────────

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

// ─── LINE Followers ─────────────────────────────────────────────────────────────

model LineFollower {
  id           Int       @id @default(autoincrement())
  lineUserId   String    @unique
  displayName  String?
  isActive     Boolean   @default(true)
  followedAt   DateTime  @default(now())
  unfollowedAt DateTime?
}
