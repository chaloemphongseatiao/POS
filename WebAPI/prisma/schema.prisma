generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  displayName  String
  role         String   @default("CASHIER")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders         Order[]
  stockMovements StockMovement[]
  shiftsOpened   Shift[]         @relation("ShiftOpenedBy")
  shiftsClosed   Shift[]         @relation("ShiftClosedBy")
  refunds        Refund[]
}

// ─── Categories ───────────────────────────────────────────────────────────────

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  products Product[]
}

// ─── Products ─────────────────────────────────────────────────────────────────

model Product {
  id          Int      @id @default(autoincrement())
  barcode     String?  @unique
  name        String
  description String?
  costPrice   Decimal
  sellPrice   Decimal
  unit        String   @default("ชิ้น")
  imageUrl    String?
  isActive    Boolean  @default(true)
  lowStockAt  Int      @default(5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  stock          Stock?
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  refundItems    RefundItem[]
}

// ─── Stock ────────────────────────────────────────────────────────────────────

model Stock {
  id        Int      @id @default(autoincrement())
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  productId Int     @unique
  product   Product @relation(fields: [productId], references: [id])
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  type      String
  quantity  Int
  note      String?
  createdAt DateTime @default(now())

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id])
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id            Int      @id @default(autoincrement())
  orderNumber   String   @unique
  subtotal      Decimal
  discountAmt   Decimal  @default(0)
  totalAmt      Decimal
  paymentMethod String
  amountPaid    Decimal
  changeAmt     Decimal
  status        String   @default("COMPLETED")
  note          String?
  createdAt     DateTime @default(now())

  cashierId Int
  cashier   User @relation(fields: [cashierId], references: [id])

  shiftId Int?
  shift   Shift? @relation(fields: [shiftId], references: [id])

  items          OrderItem[]
  stockMovements StockMovement[]
  refunds        Refund[]

  @@index([shiftId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  quantity  Int
  unitPrice Decimal
  costPrice Decimal
  subtotal  Decimal
  /// How many of `quantity` have been given back to the customer.
  refundedQty Int   @default(0)

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  refundItems RefundItem[]
}

// ─── Refunds ──────────────────────────────────────────────────────────────────

model Refund {
  id           Int      @id @default(autoincrement())
  refundNumber String   @unique
  totalAmt     Decimal
  /// Cost of the returned goods, snapshotted so reports can undo the profit.
  totalCost    Decimal  @default(0)
  reason       String?
  /// Returned goods put back on the shelf; false when they are damaged.
  restock      Boolean  @default(true)
  createdAt    DateTime @default(now())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  shiftId Int?
  shift   Shift? @relation(fields: [shiftId], references: [id])

  items RefundItem[]

  @@index([orderId])
  @@index([createdAt])
}

model RefundItem {
  id        Int     @id @default(autoincrement())
  quantity  Int
  unitPrice Decimal
  costPrice Decimal
  subtotal  Decimal

  refundId Int
  refund   Refund @relation(fields: [refundId], references: [id])

  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id])
}

// ─── Shifts ───────────────────────────────────────────────────────────────────

model Shift {
  id          Int       @id @default(autoincrement())
  /// Cash in the drawer when the shift was opened.
  openingCash Decimal
  /// Cash counted at close; null while the shift is still open.
  closingCash Decimal?
  /// Opening cash + cash sales - cash refunds, frozen at close.
  expectedCash Decimal?
  /// closingCash - expectedCash: negative means the drawer is short.
  diffCash    Decimal?
  note        String?
  openedAt    DateTime  @default(now())
  closedAt    DateTime?

  openedById Int
  openedBy   User @relation("ShiftOpenedBy", fields: [openedById], references: [id])

  closedById Int?
  closedBy   User? @relation("ShiftClosedBy", fields: [closedById], references: [id])

  orders  Order[]
  refunds Refund[]

  @@index([openedAt])
}

// ─── Settings ─────────────────────────────────────────────────────────────────

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

// ─── LINE Followers ─────────────────────────────────────────────────────────────

model LineFollower {
  id           Int       @id @default(autoincrement())
  lineUserId   String    @unique
  displayName  String?
  isActive     Boolean   @default(true)
  followedAt   DateTime  @default(now())
  unfollowedAt DateTime?
}
